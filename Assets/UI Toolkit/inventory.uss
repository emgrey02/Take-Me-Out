:root {
}

.button {
    width: 300px;
    height: 400px;
}

.row {
    flex-direction: row;
    width: auto;
    height: auto;
    justify-content: space-evenly;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    flex-grow: 1;
    align-items: center;
}

.hide {
    display: flex;
    visibility: hidden;
}

.panel {
    background-color: rgba(12, 142, 0, 0.44);
}

.card-slot {
    position: absolute;
    width: 300px;
    height: 400px;
    background-color: rgba(0, 0, 0, 0.66);
}

.card-ctn {
    flex-direction: column;
    width: 200px;
    height: 400px;
    flex-basis: initial;
    flex-shrink: 0;
    align-items: flex-start;
    align-self: auto;
    align-content: auto;
}
