<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/dialogueBox/dialogueBox.uss?fileID=7433441132597879392&amp;guid=29abb1de46fa713439b76588de91b6a1&amp;type=3#dialogueBox"/>
    <ui:VisualElement name="VisualElement" style="width: 100%; height: 100%; align-items: center; justify-content: flex-end; align-self: auto; align-content: auto; transition-property: opacity; transition-duration: 0.2s; transition-timing-function: ease-in-out;">
        <ui:VisualElement name="Box" class="red basecolor" style="width: 1000px; height: auto; max-height: 350px; margin-bottom: 50px; border-bottom-left-radius: 40px; border-top-right-radius: 90px; border-top-width: 13px; border-right-width: 13px; border-bottom-width: 13px; border-left-width: 13px; border-left-color: rgb(188, 124, 124); border-right-color: rgb(188, 124, 124); border-top-color: rgb(188, 124, 124); border-bottom-color: rgb(188, 124, 124); transition-property: opacity, background-color; transition-duration: 0.2s, 1s; background-color: rgb(255, 255, 255); flex-grow: 0; transition-timing-function: ease-in-out, ease;">
            <ui:Label text="Name" name="speakerName" style="font-size: 40px; margin-top: 0; margin-right: 30px; margin-bottom: 0; margin-left: 30px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/fonts/selfie-neue-700.ttf?fileID=12800000&amp;guid=ceb65a42685e9db4981878bbe352cb63&amp;type=3#selfie-neue-700&quot;); padding-bottom: -78px; padding-top: 10px; padding-right: 30px; padding-left: 30px; position: absolute; top: -67px; left: 33px; background-color: rgb(255, 255, 255); border-left-color: rgb(188, 123, 123); border-right-color: rgb(188, 123, 123); border-top-color: rgb(188, 123, 123); border-bottom-color: rgb(188, 123, 123); border-top-width: 13px; border-right-width: 13px; border-bottom-width: 13px; border-left-width: 13px; border-top-left-radius: 43px; border-top-right-radius: 43px; border-bottom-right-radius: 43px; border-bottom-left-radius: 43px;"/>
            <ui:Label text="Dialogue Text! " name="dialogueText" style="font-size: 24px; margin-top: 10px; margin-right: 30px; margin-bottom: 20px; margin-left: 30px; flex-wrap: wrap; flex-basis: initial; height: auto; white-space: normal; -unity-paragraph-spacing: 10px; flex-shrink: 1; align-items: flex-start; -unity-font-definition: url(&quot;project://database/Assets/fonts/rl-horizon-400.ttf?fileID=12800000&amp;guid=eb69cf80b9122864d911be23ec24dd83&amp;type=3#rl-horizon-400&quot;); padding-top: 40px;"/>
            <ui:VisualElement name="option-container" style="flex-grow: 0; flex-direction: column; align-items: flex-start; justify-content: flex-start; padding-left: 27px; flex-wrap: nowrap; flex-shrink: 1; -unity-font-definition: url(&quot;project://database/Assets/fonts/rl-horizon-400.ttf?fileID=12800000&amp;guid=eb69cf80b9122864d911be23ec24dd83&amp;type=3#rl-horizon-400&quot;); padding-top: 0; padding-bottom: 10px;">
                <ui:Button text="Button" name="option1" view-data-key="0" parse-escape-sequences="true" selectable="true" class="option" style="flex-wrap: wrap;"/>
                <ui:Button text="Button" name="option2" view-data-key="1" selectable="true" class="option"/>
                <ui:Button text="Button" name="option3" view-data-key="2" selectable="true" class="option"/>
                <ui:Button text="Button" name="option4" view-data-key="3" enabled="true" selectable="true" parse-escape-sequences="false" class="option"/>
            </ui:VisualElement>
            <ui:Button text="continue &gt;" selectable="false" focusable="true" name="nextLine" class="button" style="margin-top: 0; margin-right: 10px; margin-bottom: 0; margin-left: 10px; font-size: 26px; padding-right: 20px; padding-left: 20px; -unity-font-definition: url(&quot;project://database/Assets/fonts/rl-horizon-700.ttf?fileID=12800000&amp;guid=b99393b03af9ad943a296e4e5b16b631&amp;type=3#rl-horizon-700&quot;); position: absolute; top: auto; bottom: -45px; left: auto; background-color: rgb(255, 255, 255); border-left-color: rgb(188, 125, 125); border-right-color: rgb(188, 125, 125); border-top-color: rgb(188, 125, 125); border-bottom-color: rgb(188, 125, 125); border-top-width: 9px; border-right-width: 9px; border-bottom-width: 9px; border-left-width: 9px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
