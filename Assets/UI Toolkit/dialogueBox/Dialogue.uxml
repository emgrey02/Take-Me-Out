<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/dialogueBox/dialogueBox.uss?fileID=7433441132597879392&amp;guid=29abb1de46fa713439b76588de91b6a1&amp;type=3#dialogueBox"/>
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-color: rgba(192, 192, 192, 0); background-size: 100% 100%; width: 100%; height: 100%; align-items: center; justify-content: flex-end; align-self: auto; align-content: auto; position: relative; bottom: 10px; left: auto; right: auto; transition-property: opacity; transition-duration: 0.5s;">
        <ui:VisualElement name="Box" class="red basecolor" style="flex-grow: 1; position: relative; width: 1000px; height: 350px; max-height: 350px; margin-bottom: 50px; border-bottom-left-radius: 40px; border-top-right-radius: 90px; border-top-width: 13px; border-right-width: 13px; border-bottom-width: 13px; border-left-width: 13px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); transition-property: opacity, background-color; transition-duration: 0.5s, 1s;">
            <ui:Label text="Name" name="speakerName" style="font-size: 30px; margin-top: 0; margin-right: 30px; margin-bottom: 0; margin-left: 30px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/fonts/rl-horizon-700.ttf?fileID=12800000&amp;guid=b99393b03af9ad943a296e4e5b16b631&amp;type=3#rl-horizon-700&quot;); padding-bottom: 10px; padding-top: 10px; padding-right: 0; padding-left: 0;"/>
            <ui:Label text="Dialogue Text! " name="dialogueText" style="font-size: 24px; margin-top: 10px; margin-right: 30px; margin-bottom: 20px; margin-left: 30px; flex-wrap: wrap; flex-basis: initial; height: auto; white-space: normal; -unity-paragraph-spacing: 10px; flex-shrink: 1; align-items: flex-start; -unity-font-definition: url(&quot;project://database/Assets/fonts/rl-horizon-400.ttf?fileID=12800000&amp;guid=eb69cf80b9122864d911be23ec24dd83&amp;type=3#rl-horizon-400&quot;);"/>
            <ui:VisualElement name="option-container" style="flex-grow: 1; flex-direction: column; align-items: flex-start; justify-content: flex-start; padding-left: 27px; flex-wrap: nowrap; flex-shrink: 1; -unity-font-definition: url(&quot;project://database/Assets/fonts/rl-horizon-400.ttf?fileID=12800000&amp;guid=eb69cf80b9122864d911be23ec24dd83&amp;type=3#rl-horizon-400&quot;);">
                <ui:Button text="Button" name="option1" view-data-key="0" parse-escape-sequences="true" selectable="true" class="option" style="flex-wrap: wrap;"/>
                <ui:Button text="Button" name="option2" view-data-key="1" selectable="true" class="option"/>
                <ui:Button text="Button" name="option3" view-data-key="2" selectable="true" class="option"/>
                <ui:Button text="Button" name="option4" view-data-key="3" enabled="true" selectable="true" parse-escape-sequences="false" class="option"/>
            </ui:VisualElement>
            <ui:Button text="continue..." selectable="false" focusable="true" name="nextLine" class="button" style="margin-top: 0; margin-right: 10px; margin-bottom: 0; margin-left: 10px; font-size: 20px; padding-right: 20px; padding-left: 20px; -unity-font-definition: url(&quot;project://database/Assets/fonts/rl-horizon-700.ttf?fileID=12800000&amp;guid=b99393b03af9ad943a296e4e5b16b631&amp;type=3#rl-horizon-700&quot;);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
