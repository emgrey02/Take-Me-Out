            <ui:VisualElement style="flex-grow: 1; width: 20%; height: 100%; flex-direction: column;">
                <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: column; align-self: auto; justify-content: center; align-content: auto; margin-top: 18px; margin-right: 18px; margin-bottom: 18px; margin-left: 18px; border-top-width: 24px; border-right-width: 24px; border-bottom-width: 24px; border-left-width: 24px; aspect-ratio: auto;">
                    <ui:VisualElement name="Slot" style="flex-grow: 1; position: absolute; aspect-ratio: 0.75; width: 100%; height: auto; background-color: rgb(0, 0, 0);"/>
                    <ui:Image tint-color="rgb(238, 0, 0)" name="Big-Card" style="aspect-ratio: 0.75; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;"/>
                </ui:VisualElement>
