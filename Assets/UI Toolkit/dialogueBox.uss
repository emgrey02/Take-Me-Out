:root {
    transition-property: opacity;
}

.hide {
    visibility: visible;
    transition-property: opacity;
    opacity: 0;
    transition-duration: 0.5s;
}

.button {
    align-self: flex-end;
    margin-top: 30px;
    margin-right: 30px;
    margin-bottom: 30px;
    margin-left: 30px;
    justify-content: flex-end;
    position: absolute;
    bottom: 0;
    right: 0;
    font-size: 40px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 28px;
}

.unity-button {
    border-bottom-left-radius: -76px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    transition-property: color;
    transition-duration: 0.2s;
    font-size: 18px;
}

.unity-button:hover {
    transition-property: color, -unity-text-outline-width;
    transition-duration: 0.2s, 0.2s;
    color: rgb(255, 0, 0);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(156, 29, 29);
}
