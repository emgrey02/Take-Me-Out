            <ui:VisualElement name="question-ctn" class="remove" style="flex-grow: 1; justify-content: flex-start; height: 600px; -unity-font-definition: url(&quot;project://database/Assets/fonts/rl-horizon-400.ttf?fileID=12800000&amp;guid=eb69cf80b9122864d911be23ec24dd83&amp;type=3#rl-horizon-400&quot;); margin-top: 43.12px;">
