                <ui:Label text="What is the most important date in November?" name="question" class="main-text" style="flex-wrap: wrap; -unity-text-align: upper-left; margin-left: 430px; margin-top: 24.27px; font-size: 34px; white-space: normal; margin-right: 83.45px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/fonts/rl-horizon-700.ttf?fileID=12800000&amp;guid=b99393b03af9ad943a296e4e5b16b631&amp;type=3#rl-horizon-700&quot;);"/>
                <ui:VisualElement name="VisualElement" style="flex-grow: 1; align-items: flex-start; width: 100%; align-self: center; align-content: flex-start; flex-direction: row; -unity-font-definition: url(&quot;project://database/Assets/fonts/rl-horizon-700.ttf?fileID=12800000&amp;guid=b99393b03af9ad943a296e4e5b16b631&amp;type=3#rl-horizon-700&quot;); -unity-text-align: upper-left; justify-content: center; margin-top: 80px;">
                    <ui:VisualElement class="answer" style="flex-grow: 0; flex-direction: column; align-items: flex-start; color: rgb(255, 255, 255);">
