:root {
}

.button {
    width: 100%;
    height: 100%;
    aspect-ratio: 0.75;
    min-width: 100px;
    max-width: 300px;
    max-height: none;
}

.row {
    flex-direction: row;
    width: auto;
    height: auto;
    justify-content: space-around;
    margin-top: 27px;
    margin-right: 27px;
    margin-bottom: 27px;
    margin-left: 27px;
    flex-grow: 0.38;
    align-items: center;
    flex-wrap: nowrap;
    flex-shrink: 1;
    align-self: auto;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.hide {
    display: flex;
    visibility: hidden;
}

.panel {
    width: 100%;
    height: 100%;
    background-color: rgba(154, 42, 0, 0.69);
    align-items: center;
    justify-content: center;
    align-self: auto;
    align-content: auto;
    flex-direction: column;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 45px;
    padding-right: 45px;
    padding-bottom: 45px;
    padding-left: 45px;
}

.card-slot {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.card-ctn {
    flex-direction: column;
    width: initial;
    height: 100%;
    flex-basis: initial;
    flex-shrink: 0;
    align-items: flex-start;
    align-self: auto;
    align-content: auto;
    min-width: auto;
    max-width: 300px;
    aspect-ratio: 0.75;
    margin-top: -30px;
    margin-right: -30px;
    margin-bottom: -30px;
    margin-left: -30px;
    flex-wrap: nowrap;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    transition-property: scale, translate;
    transition-duration: 0.2s, 0.2s;
}

.card-ctn:hover {
    scale: 1.2 1.2;
    transition-property: scale, translate;
    transition-duration: 0.2s, 0.2s;
    translate: 0 -150px 0.05px;
}
