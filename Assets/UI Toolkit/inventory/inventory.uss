:root {
}

.button {
    width: 100%;
    height: 100%;
    aspect-ratio: 0.75;
    min-width: 100px;
    max-width: 300px;
    max-height: none;
}

.row {
    flex-direction: row;
    width: auto;
    height: auto;
    justify-content: space-around;
    margin-top: 27px;
    margin-right: 27px;
    margin-bottom: 27px;
    margin-left: 27px;
    flex-grow: 0.38;
    align-items: center;
    flex-wrap: nowrap;
    flex-shrink: 1;
    align-self: auto;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.hide {
    display: flex;
    visibility: hidden;
}

.panel {
    width: 100%;
    height: 100%;
    background-color: rgba(154, 42, 0, 0.69);
    align-items: center;
    justify-content: center;
    align-self: auto;
    align-content: auto;
    flex-direction: column;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 45px;
    padding-right: 45px;
    padding-bottom: 45px;
    padding-left: 45px;
    background-image: resource("TMO_inventory_bg");
}

.card-slot {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(43, 43, 43);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(188, 188, 188);
    border-right-color: rgb(188, 188, 188);
    border-top-color: rgb(188, 188, 188);
    border-bottom-color: rgb(188, 188, 188);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    aspect-ratio: 0.691;
}

.card-ctn {
    flex-direction: column;
    width: initial;
    height: 100%;
    flex-basis: initial;
    flex-shrink: 0;
    align-items: flex-start;
    align-self: auto;
    align-content: auto;
    min-width: auto;
    max-width: 300px;
    aspect-ratio: 0.691;
    margin-top: -30px;
    margin-right: -30px;
    margin-bottom: -30px;
    margin-left: -30px;
    flex-wrap: nowrap;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    transition-property: translate, scale;
    transition-duration: 0.2s, 0.2s;
}

.card-ctn:hover {
    aspect-ratio: 0.691;
    translate: 0 -30px;
    scale: 1.2 1.2;
}

.unity-button {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    background-color: rgb(255, 0, 0);
    aspect-ratio: 0.691;
}


