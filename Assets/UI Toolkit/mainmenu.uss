:root {
}

.panel {
    background-color: rgba(123, 52, 49, 0.79);
    align-items: flex-start;
    justify-content: center;
    border-top-width: 48px;
    border-right-width: 48px;
    border-bottom-width: 48px;
    border-left-width: 48px;
}

.hide {
    display: flex;
    visibility: hidden;
}

.menu {
    align-items: stretch;
    align-content: auto;
    width: 70%;
    height: 100%;
    background-color: rgba(108, 24, 24, 0);
    margin-left: 30px;
    flex-grow: 1;
    justify-content: space-between;
    align-self: auto;
    flex-direction: column;
}

.unity-button {
    align-items: auto;
    width: 40%;
    height: auto;
    min-width: auto;
    min-height: auto;
    align-self: auto;
    border-top-left-radius: 0;
    border-top-right-radius: 80px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 40px;
    padding-top: 20px;
    padding-right: 0;
    padding-bottom: 20px;
    padding-left: 0;
    margin-right: 10px;
    margin-left: 10px;
    margin-top: 10px;
    margin-bottom: 10px;
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-left-width: 8px;
    border-left-color: rgba(120, 23, 23, 0.5);
    border-right-color: rgba(120, 23, 23, 0.5);
    border-top-color: rgba(120, 23, 23, 0.5);
    border-bottom-color: rgba(120, 23, 23, 0.5);
    font-size: 80px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=f005909a0ab2da84192c2c5c01d36fae&type=3#NotInter-Regular");
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.64);
    transition-property: scale, background-color;
    transition-duration: 0.2s, 0.2s;
    align-content: auto;
    flex-shrink: 1;
    flex-grow: 0;
}

.unity-button:hover {
    background-color: rgb(226, 172, 25);
    scale: 1.1 1.1;
    transition-property: scale, background-color;
    transition-duration: 0.2s, 0.2s;
}

.remove {
    display: none;
}

.unity-base-field {
    margin-bottom: 20px;
    flex-direction: row;
    justify-content: space-between;
}

.unity-base-slider {
    width: auto;
    flex-direction: column;
    align-items: auto;
    align-self: stretch;
    align-content: stretch;
    justify-content: space-between;
}

.unity-slider-int {
    justify-content: flex-end;
    align-items: stretch;
    flex-direction: row;
    align-self: auto;
    align-content: stretch;
}

.unity-base-slider__tracker {
    width: initial;
    height: 10px;
    background-color: rgb(0, 0, 0);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    margin-left: 19px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.unity-base-slider__dragger {
    align-self: auto;
    align-content: auto;
    align-items: auto;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    background-color: rgb(250, 195, 195);
    margin-top: -22px;
}

.unity-label {
    font-size: 24px;
    -unity-font-style: normal;
    flex-wrap: wrap;
}

.big-label {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-top: 10px;
}

.input-field {
    flex-direction: row;
    background-color: rgb(208, 187, 187);
    border-top-width: 20px;
    border-left-color: rgb(164, 105, 105);
    border-right-color: rgb(164, 105, 105);
    border-top-color: rgb(164, 105, 105);
    border-bottom-color: rgb(164, 105, 105);
    padding-top: 15px;
    padding-right: 30px;
    padding-bottom: 15px;
    padding-left: 30px;
    border-bottom-left-radius: 40px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 40px;
}
