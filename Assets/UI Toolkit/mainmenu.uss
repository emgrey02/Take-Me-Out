:root {
}

.panel {
    background-color: rgba(123, 52, 49, 0.79);
    align-items: flex-start;
    justify-content: center;
    border-top-width: 48px;
    border-right-width: 48px;
    border-bottom-width: 48px;
    border-left-width: 48px;
}

.hide {
    display: flex;
    visibility: hidden;
}

.menu {
    align-items: flex-start;
    align-content: center;
    width: 51%;
    height: 75%;
    background-color: rgba(108, 24, 24, 0);
    margin-left: 30px;
}

.unity-button {
    flex-grow: 1;
    align-items: auto;
    width: 70%;
    height: auto;
    min-width: auto;
    min-height: auto;
    align-self: stretch;
    border-top-left-radius: -27px;
    border-top-right-radius: 67px;
    border-bottom-right-radius: -30px;
    border-bottom-left-radius: 32px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-right: 10px;
    margin-left: 10px;
    margin-top: 10px;
    margin-bottom: 10px;
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 8px;
    border-left-width: 8px;
    border-left-color: rgba(120, 23, 23, 0.5);
    border-right-color: rgba(120, 23, 23, 0.5);
    border-top-color: rgba(120, 23, 23, 0.5);
    border-bottom-color: rgba(120, 23, 23, 0.5);
    font-size: 80px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=f005909a0ab2da84192c2c5c01d36fae&type=3#NotInter-Regular");
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.64);
    transition-property: scale;
    transition-duration: 0.2s;
}

.unity-button:hover {
    background-color: rgb(226, 172, 25);
    scale: 1.1 1.1;
}
